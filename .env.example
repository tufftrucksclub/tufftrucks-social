# Copy this file to .env and fill in what you have. Anything left blank is simply
# skipped — the app works with whatever is connected. SETUP.md walks through each one.

# ---- Try it first with fake data (no accounts needed). Set back to 0 when you go real.
DEMO_MODE=0

# ---- Claude (writes the plans and captions, rates review photos)
# console.anthropic.com → API keys. Billed separately from a claude.ai subscription.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Shopify (products, best sellers, and hosting post images so platforms can fetch them)
# Dev Dashboard app with scopes: read_products, read_files, write_files, read_orders
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only if you still have an old admin-created custom app token (shpat_...). Otherwise leave blank.
SHOPIFY_ACCESS_TOKEN=
STORE_URL=https://tufftrucks.club

# ---- Etsy (reviews + listings, read-only)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=

# ---- Facebook Page + Instagram (can also be pasted on the Settings page)
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# ---- TikTok (developers.tiktok.com → your app → Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Pinterest (developers.pinterest.com)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_USE_SANDBOX=0

# ---- X (developer.x.com → OAuth 2.0, Web App)
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- Where your browser reaches this app. Used for the "Connect" logins.
# Register  <PUBLIC_BASE_URL>/oauth/<tiktok|pinterest|x>/callback  with each platform.
PUBLIC_BASE_URL=http://localhost:8420
PORT=8420

# ---- iCloud Photos (optional). Easiest is to connect on the Photos page instead; the password is then never saved.
# Set ICLOUD_PASSWORD only if you want an expired session to log itself back in without you.
ICLOUD_APPLE_ID=
ICLOUD_PASSWORD=

# ---- Optional extras
# AI backgrounds: photoreal scenes painted around your truck on the Photos page (~20 cents each at "high"),
# plus AI backdrop scenes in the Studio. Background removal (requirements-cutout.txt) is needed too.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
# Background-removal model. u2netp is much faster on a Raspberry Pi; isnet-general-use is cleaner.
REMBG_MODEL=isnet-general-use
